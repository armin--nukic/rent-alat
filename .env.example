# Copy this file to .env locally or on the VPS. Never commit a real .env file.
NODE_ENV=production

# PostgreSQL is internal to Docker; host ports are only for optional local administration.
POSTGRES_DB=rent_alat
POSTGRES_USER=rent_alat
POSTGRES_PASSWORD=CHANGE_TO_A_LONG_RANDOM_DATABASE_PASSWORD
POSTGRES_HOST_PORT=5544

# Backend authentication. Generate a long random value, for example: openssl rand -hex 32
JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_JWT_SECRET
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_TO_A_STRONG_ADMIN_PASSWORD
BACKEND_HOST_PORT=8888

# Public web address. This allows CORS if a browser accesses the API directly.
FRONTEND_HOST_PORT=7777
CORS_ORIGIN=https://rent-alat.ice.lol,http://localhost:7777

# Contact messages always save in PostgreSQL. SMTP fields enable email forwarding.
CONTACT_RECIPIENT=arminnuk@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=arminnuk@gmail.com
SMTP_PASS=PASTE_A_GMAIL_APP_PASSWORD_HERE
SMTP_FROM=Rent Alat BiH <arminnuk@gmail.com>

# Prisma Studio is only for private administration; do not publicly expose it on a VPS.
PRISMA_STUDIO_HOST_PORT=6666
